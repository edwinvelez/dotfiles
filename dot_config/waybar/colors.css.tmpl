{{- $t := .theme -}}
/* Generated from .chezmoidata/theme.toml ({{ $t.name }}) */
@define-color base    #{{ $t.base }};
@define-color surface #{{ $t.surface }};
@define-color overlay #{{ $t.overlay }};
@define-color muted   #{{ $t.muted }};
@define-color text    #{{ $t.text }};
@define-color accent  #{{ $t.accent }};
@define-color alert   #{{ $t.alert }};
@define-color warn    #{{ $t.warn }};
@define-color ok      #{{ $t.ok }};
