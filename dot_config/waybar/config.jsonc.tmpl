{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,

{{ if .is_desktop -}}
    // Desktop: GPU enabled, Battery disabled
    "modules-left": ["hyprland/workspaces", "hyprland/mode"],
    "modules-center": ["clock", "hyprland/window"],
    "modules-right": ["pulseaudio", "cpu", "memory", "network", "custom/gpu", "tray"],
{{- else if .is_laptop -}}
    // Laptop: Battery enabled, GPU disabled (save power)
    "modules-left": ["hyprland/workspaces", "hyprland/mode"],
    "modules-center": ["clock", "hyprland/window"],
    "modules-right": ["pulseaudio", "cpu", "memory", "network", "battery", "tray"],
{{- end }}

    // --- Module Configurations ---
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "",
            "2": "Code",
            "3": "Term",
            "urgent": "!",
            "focused": "Focused",
            "default": "Default"
        }
    },

    "hyprland/window": {
        "format": " {title} ",
        "max-length": 50,
        "separate-outputs": true
    },

    "cpu": { "format": " {usage}%", "interval": 2 },
    "memory": { "format": " {}%" },

    "clock": {
        "interval": 60,
        "format": " {:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "max-length": 25
    },

    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": " MUTED",
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " {ipaddr}",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}"
    },

{{ if .is_desktop -}}
    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "format": "󰢮 {}%",
        "interval": 5,
        "tooltip": false
    },
{{- else if .is_laptop -}}
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
{{- end }}

    "tray": {
        "icon-size": 18,
        "spacing": 12
    }
}
