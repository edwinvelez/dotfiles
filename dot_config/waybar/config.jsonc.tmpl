{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,

{{ if .is_desktop -}}
    // Desktop: GPU & Notification enabled, Battery disabled
    "modules-left": ["ext/workspaces", "idle_inhibitor", "custom/recording"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["mpris", "pulseaudio", "cpu", "memory", "network", "custom/gpu", "tray", "custom/notification", "clock"],
{{- else if .is_laptop -}}
    // Laptop: Battery, Backlight & Notification enabled, GPU disabled (save power)
    "modules-left": ["ext/workspaces", "idle_inhibitor", "custom/recording"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["mpris", "pulseaudio", "backlight", "cpu", "memory", "network", "power-profiles-daemon", "battery", "tray", "custom/notification", "clock"],
{{- end }}

    // --- Module Configurations ---
    // ext/workspaces (standard protocol) instead of hyprland/workspaces: Waybar 0.15's
    // Hyprland module sends legacy dispatch strings, which the Lua config rejects.
    // Generic state dots: filled = focused, hollow = in use. Hidden/special workspaces stay hidden.
    "ext/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "sort-by-id": true,
        "format-icons": {
            "active": "●",
            "default": "○"
        }
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Idle Inhibitor: Active (Awake)",
        "tooltip-format-deactivated": "Idle Inhibitor: Inactive (Normal Sleep)"
    },

    // Now playing (any MPRIS player: Chrome tabs, mpv, Spotify). Hidden when nothing plays.
    // Click: play/pause. Scroll: next/previous track. Paused shows in muted colour.
    "mpris": {
        "format": "{status_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "status-icons": { "playing": "󰐊", "paused": "󰏤", "stopped": "󰓛" },
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 40,
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip-format": "{player}: {title} — {artist}\nClick: play/pause · Scroll: next/previous"
    },

    "hyprland/window": {
        "format": " {title} ",
        "max-length": 50,
        "separate-outputs": true
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 2,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": "󰘚 {}%",
        "interval": 2,
        "on-click": "kitty -e btop"
    },

    // Far right: date + time. Hover for a calendar; scroll to change month,
    // middle-click to return to today, right-click for the year view.
    "clock": {
        "interval": 60,
        "format": "{:%a %b %d  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#{{ .theme.text }}'><b>{}</b></span>",
                "weekdays": "<span color='#{{ .theme.accent }}'><b>{}</b></span>",
                "days":     "<span color='#{{ .theme.text }}'>{}</span>",
                "weeks":    "<span color='#{{ .theme.muted }}'>W{}</span>",
                "today":    "<span color='#{{ .theme.accent }}'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-middle": "shift_reset",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        },
        "on-click": "swaync-client -t -sw"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "nm-connection-editor"
    },

{{ if .is_desktop -}}
    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "format": "󰢮 {}%",
        "interval": 5,
        "tooltip": false,
        "on-click": "kitty -e nvtop"
    },
{{- else if .is_laptop -}}
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set +1%",
        "on-scroll-down": "brightnessctl set 1%-"
    },
    // Click cycles profiles, right-click goes back. Colour only when not on balanced.
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nClick to cycle",
        "format-icons": {
            "default": "󰾅",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆"
        }
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-icons": ["󰂃", "󰁻", "󰁽", "󰁿", "󰁹"],
        "tooltip-format": "{timeTo}, {power}W"
    },
{{- end }}

    // Shown only while ~/.local/bin/record is running; the script sends SIGRTMIN+8 on start/stop.
    "custom/recording": {
        "exec": "record status",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "record"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚<span foreground='#{{ .theme.alert }}'><sup></sup></span>",
            "none": "󰂚",
            "dnd-notification": "󰂛<span foreground='#{{ .theme.alert }}'><sup></sup></span>",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚<span foreground='#{{ .theme.alert }}'><sup></sup></span>",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛<span foreground='#{{ .theme.alert }}'><sup></sup></span>",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "tray": {
        "icon-size": 18,
        "spacing": 12
    }
}
