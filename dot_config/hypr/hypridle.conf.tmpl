general {
    lock_cmd = pidof hyprlock || hyprlock
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({ action = "on" })'
}

{{ if .is_desktop -}}
# Desktop: No battery conservation (dimming) needed.
# Just lock and turn off screen for privacy/burn-in protection.

# Screen off 30s after a manual lock (SUPER + L); does nothing while unlocked
listener {
    timeout = 30
    on-timeout = pidof hyprlock && hyprctl dispatch 'hl.dsp.dpms({ action = "off" })'
    on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = "on" })'
}

# Lock the screen after 10 minutes
listener {
    timeout = 600
    on-timeout = loginctl lock-session
}

# Turn off monitor after 15 minutes
listener {
    timeout = 900
    on-timeout = hyprctl dispatch 'hl.dsp.dpms({ action = "off" })'
    on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = "on" })'
}
{{- else if .is_laptop -}}
# Laptop: Power conservation & battery preservation

# 1. Dim the screen and turn off the keyboard backlight after 2.5 minutes.
#    -s/-r save and restore each device's own level.
listener {
    timeout = 150
    on-timeout = brightnessctl -s set 10% && brightnessctl -sd dell::kbd_backlight set 0
    on-resume = brightnessctl -r && brightnessctl -rd dell::kbd_backlight
}

# Screen off 30s after a manual lock (SUPER + L); does nothing while unlocked
listener {
    timeout = 30
    on-timeout = pidof hyprlock && hyprctl dispatch 'hl.dsp.dpms({ action = "off" })'
    on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = "on" })'
}

# 2. Lock the screen after 5 minutes
listener {
    timeout = 300
    on-timeout = loginctl lock-session
}

# 3. Turn off screen after 6 minutes
listener {
    timeout = 360
    on-timeout = hyprctl dispatch 'hl.dsp.dpms({ action = "off" })'
    on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = "on" })'
}

# 4. Suspend after 20 minutes, but only on battery. On AC (charging, full or
#    "not charging") it just stays locked with the screen off, so downloads,
#    builds and SSH sessions survive. BAT* skips the mouse's hidpp battery.
listener {
    timeout = 1200
    on-timeout = grep -qx Discharging /sys/class/power_supply/BAT*/status && systemctl suspend
}
{{- end }}
