general {
    no_fade_in = false
    grace = 0
    disable_loading_bar = true
}

background {
    monitor =
    path = screenshot
    color = rgba({{ .theme.base }}ff)
    blur_passes = 2
    blur_size = 7
    noise = 0.0117
    contrast = 0.8916
    brightness = 0.8172
    vibrancy = 0.1696
    vibrancy_darkness = 0.0
}

# 24-Hour Clock
label {
    monitor =
    text = $TIME
    color = rgba({{ .theme.text }}ff)
    font_size = 80
    font_family = Inter ExtraBold

    shadow_passes = 2
    shadow_size = 3
    shadow_color = rgba(00000099)

    position = 0, 100
    halign = center
    valign = center
}

# Date
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%A, %B %d")"
    color = rgba({{ .theme.muted }}ff)
    font_size = 22
    font_family = Inter Medium
    position = 0, 30
    halign = center
    valign = center
}

# User Input Field
input-field {
    monitor =
    size = 250, 50
    outline_thickness = 2
    dots_size = 0.25
    dots_spacing = 0.2
    dots_center = true

    rounding = {{ .theme.radius }}
    outer_color = rgba({{ .theme.overlay }}ff)
    inner_color = rgba({{ .theme.surface }}e6)
    font_color = rgba({{ .theme.text }}ff)
    check_color = rgba({{ .theme.accent }}ff)

    capslock_color = rgba({{ .theme.warn }}ff) # Caps Lock on
    fail_color = rgba({{ .theme.alert }}ff) # Wrong password
    fail_text = <i>$FAIL <b>($ATTEMPTS)</b></i>

    fade_on_empty = true
    placeholder_text = <i>Password...</i>
    hide_input = false

    position = 0, -50
    halign = center
    valign = center
}

image {
    monitor =
    path = {{ .chezmoi.homeDir }}/.face.icon
    size = 120
    rounding = -1
    border_size = 3
    border_color = rgba({{ .theme.accent }}ff)
    position = 0, 180
    halign = center
    valign = center
}

# Now playing (media keys work while locked). Empty, so hidden, when no player runs.
# sed escapes & and < because the label text is Pango markup.
label {
    monitor =
    text = cmd[update:2000] t=$(playerctl metadata title 2>/dev/null) && a=$(playerctl metadata artist 2>/dev/null); [ -n "$t" ] && echo "󰎆  $t${a:+ — $a}" | cut -c1-80 | sed 's/&/\&amp;/g; s/</\&lt;/g'
    color = rgba({{ .theme.muted }}ff)
    font_size = 14
    font_family = Inter Medium
    position = 0, 40
    halign = center
    valign = bottom
}
{{- if .is_laptop }}

# Battery (laptop)
label {
    monitor =
    text = cmd[update:30000] b=$(ls -d /sys/class/power_supply/BAT* | head -1); c=$(cat $b/capacity); [ "$(cat $b/status)" = Discharging ] && i=󰁹 || i=󰂄; echo "$i  $c%"
    color = rgba({{ .theme.muted }}ff)
    font_size = 14
    font_family = Inter Medium
    position = -30, 30
    halign = right
    valign = bottom
}
{{- end }}
