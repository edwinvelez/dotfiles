-- --- Toolkit Backends (Native Wayland) ---
hl.env("GDK_BACKEND", "wayland,x11")
hl.env("SDL_VIDEODRIVER", "wayland")
hl.env("CLUTTER_BACKEND", "wayland")
hl.env("QT_QPA_PLATFORM", "wayland;xcb")
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "wayland")

-- --- Qt Theming (Pure Qt6CT, No KDE Dependencies) ---
hl.env("QT_QPA_PLATFORMTHEME", "qt6ct")
hl.env("QT_STYLE_OVERRIDE", "Fusion")
hl.env("QT_PASSWORD_STORE", "gnome-libsecret")
hl.env("PASSWORD_STORE_SET", "gnome-libsecret")

-- --- Font Rendering ---
hl.env("XFT_ANTIALIAS", "true")
hl.env("XFT_HINTING", "slight")
hl.env("XFT_HINTSTYLE", "hintslight")
hl.env("XFT_RGBA", "rgb")

-- --- Cursor Theming ---
hl.env("XCURSOR_THEME", "Bibata-Modern-Classic")
hl.env("HYPRCURSOR_THEME", "Bibata-Modern-Classic")
{{ if .is_laptop -}}
hl.env("XCURSOR_SIZE", "32")
hl.env("HYPRCURSOR_SIZE", "32")
{{ else -}}
hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")
{{ end -}}

-- --- Java / AWT Non-Reparenting Fix (JetBrains IDEs) ---
-- NOTE: Required specifically for JetBrains IDEs (IntelliJ, WebStorm, PyCharm, Toolbox).
-- Under tiling Wayland compositors like Hyprland, Java AWT/Swing applications can render
-- blank grey windows or have misplaced popups unless non-reparenting mode is explicitly declared.
hl.env("_JAVA_AWT_WM_NONREPARENTING", "1")

-- --- SSH Agent Socket ---
hl.env("SSH_AUTH_SOCK", "$XDG_RUNTIME_DIR/ssh-agent.socket")

-- --- Hardware Profile Environment ---
{{ if .is_desktop -}}
-- Desktop (NVIDIA Driver Environment)
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("XDG_SESSION_TYPE", "wayland")
hl.env("GBM_BACKEND", "nvidia-drm")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("__GL_GSYNC_ALLOWED", "0")
hl.env("__GL_VRR_ALLOWED", "0")

{{- else if .is_laptop -}}
-- Laptop (Intel / Mesa Driver Environment)
hl.env("LIBVA_DRIVER_NAME", "iHD")
hl.env("XDG_SESSION_TYPE", "wayland")
hl.env("GBM_BACKEND", "drm")
hl.env("__EGL_VENDOR_LIBRARY_FILENAMES", "/usr/share/glvnd/egl_vendor.d/50_mesa.json")

-- High-DPI Scaling
hl.env("GDK_SCALE", "1")
hl.env("QT_AUTO_SCREEN_SCALE_FACTOR", "1")
{{- end }}
