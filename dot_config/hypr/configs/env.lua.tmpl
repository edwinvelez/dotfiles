-- --- Toolkit Backends (Native Wayland) ---
hl.env("GDK_BACKEND", "wayland,x11")
hl.env("SDL_VIDEODRIVER", "wayland,x11")
hl.env("CLUTTER_BACKEND", "wayland")
hl.env("QT_QPA_PLATFORM", "wayland;xcb")
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "wayland")

-- --- Qt Theming (Pure Qt6CT, No KDE Dependencies) ---
hl.env("QT_QPA_PLATFORMTHEME", "qt6ct")
-- Widget style comes from qt6ct.conf (style=Fusion); QT_STYLE_OVERRIDE would silently override it.
hl.env("QT_PASSWORD_STORE", "gnome-libsecret")

-- --- Font Rendering ---
-- Not set here: no toolkit reads XFT_* env vars. Rendering comes from
-- fontconfig/fonts.conf (everything), gtk settings.ini and xsettingsd (XWayland).

-- --- Cursor Theming ---
hl.env("XCURSOR_THEME", "{{ .ui.cursor_theme }}")
hl.env("HYPRCURSOR_THEME", "{{ .ui.cursor_theme }}")
hl.env("XCURSOR_SIZE", "{{ .cursor_size }}")
hl.env("HYPRCURSOR_SIZE", "{{ .cursor_size }}")

-- --- Java / AWT Non-Reparenting Fix (JetBrains IDEs) ---
-- NOTE: Required specifically for JetBrains IDEs (IntelliJ, WebStorm, PyCharm, Toolbox).
-- Under tiling Wayland compositors like Hyprland, Java AWT/Swing applications can render
-- blank grey windows or have misplaced popups unless non-reparenting mode is explicitly declared.
hl.env("_JAVA_AWT_WM_NONREPARENTING", "1")

-- --- SSH Agent Socket ---
-- Provided by the systemd user unit ssh-agent.socket. hl.env does not expand
-- shell variables, so resolve the runtime dir in Lua.
hl.env("SSH_AUTH_SOCK", os.getenv("XDG_RUNTIME_DIR") .. "/ssh-agent.socket")

-- --- Hardware Profile Environment ---
{{ if .is_desktop -}}
-- Desktop (NVIDIA Driver Environment)
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("NVD_BACKEND", "direct")
hl.env("GBM_BACKEND", "nvidia-drm")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("__GL_GSYNC_ALLOWED", "0")
hl.env("__GL_VRR_ALLOWED", "0")

{{- else if .is_laptop -}}
-- Laptop (Intel / Mesa Driver Environment)
-- GBM and EGL use their defaults (Mesa on the iGPU); pinning EGL to Mesa would stop
-- prime-run from using NVIDIA's EGL. XDG_SESSION_TYPE comes from logind (SDDM).
hl.env("LIBVA_DRIVER_NAME", "iHD")

-- High-DPI Scaling (Qt 6 scales automatically; QT_AUTO_SCREEN_SCALE_FACTOR is Qt 5 only)
hl.env("GDK_SCALE", "1")
{{- end }}
