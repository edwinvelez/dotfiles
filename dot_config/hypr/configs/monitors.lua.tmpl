------------------
---- MONITORS ----
------------------

{{- if .is_my_desktop }}
hl.monitor({
    output   = "HDMI-A-1",
    mode     = "3840x2160@60.00Hz",
    position = "0x0",
    scale    = 1.25,
})
{{- else if .is_my_laptop }}
hl.monitor({
    output   = "eDP-1",
    mode     = "3840x2400@60.00Hz",
    position = "0x0",
    scale    = 1.5,
})
{{- else if .is_laptop }}
hl.monitor({
    output   = "eDP-1",
    mode     = "preferred",
    position = "auto",
    scale    = 1.25,
})
{{- end }}
