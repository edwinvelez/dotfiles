hl.on("hyprland.start", function ()
    -- --- Core System Services (High Priority) ---
    -- Handled elsewhere, intentionally not launched here:
    --   session env -> Hyprland exports it to systemd/D-Bus itself
    --   keyring     -> gnome-keyring-daemon.socket + pam_gnome_keyring (SDDM)
    --   user dirs   -> xdg-user-dirs.service
    hl.exec_cmd("systemctl --user start hyprpolkitagent")
    hl.exec_cmd("xsettingsd")

    -- --- GTK & Theming Synchronization ---
    hl.exec_cmd("gsettings set org.gnome.desktop.interface gtk-theme 'Materia-dark-compact'")
    hl.exec_cmd("gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark'")
    hl.exec_cmd("gsettings set org.gnome.desktop.interface cursor-theme 'Bibata-Modern-Classic'")
    hl.exec_cmd("gsettings set org.gnome.desktop.interface font-name 'Inter 11'")
    hl.exec_cmd("gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'")

    -- --- UI & Desktop Environment ---
    hl.exec_cmd("waybar")
    hl.exec_cmd("swaync")
    hl.exec_cmd("hypridle")
    hl.exec_cmd("awww-daemon")
    {{ if .is_laptop -}}
    hl.exec_cmd("hyprctl setcursor Bibata-Modern-Classic 32")
    {{ else -}}
    hl.exec_cmd("hyprctl setcursor Bibata-Modern-Classic 24")
    {{ end -}}

    -- --- Clipboard & Multimedia ---
    hl.exec_cmd("wl-paste --type text --watch cliphist store")
    hl.exec_cmd("wl-paste --type image --watch cliphist store")

    -- --- Applets & Hardware ---
    hl.exec_cmd("nm-applet --indicator")
    hl.exec_cmd("blueman-applet")
    hl.exec_cmd("udiskie --appindicator -t")

    -- --- Background Apps ---
    -- Hyprland does not process XDG autostart (~/.config/autostart), so apps that
    -- rely on it must be launched here. The delay lets Waybar's tray come up first,
    -- since Toolbox starts minimized to the tray.
    hl.exec_cmd("sleep 10 && /opt/jetbrains-toolbox/jetbrains-toolbox --minimize")
end)
