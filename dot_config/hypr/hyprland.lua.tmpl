hl.gesture({
    fingers = 3,
    direction = "horizontal",
    action = "workspace",
})

hl.gesture({
    fingers = 3,
    direction = "down",
    mod = "ALT",
    action = "close",
})

hl.gesture({
    fingers = 3,
    direction = "up",
    mod = "SUPER",
    scale = 1.5,
    action = "fullscreen",
})

