require("configs.env")

-- Load core lifecycle startups
require("configs.execs")

-----------------------
---- LOOK AND FEEL ----
-----------------------

hl.config({
    xwayland = {
        force_zero_scaling = true,
    },

    general = {
        gaps_in = 5,
        gaps_out = 10,
        border_size = 2,
        -- Colours come from .chezmoidata/theme.toml
        col = {
            active_border   = "rgba({{ .theme.accent }}ff)",
            inactive_border = "rgba({{ .theme.overlay }}ff)",
        },
        layout = "dwindle",
    },

    decoration = {
        rounding = {{ .theme.radius }},
        dim_inactive = true,
        dim_strength = 0.1,

        blur = {
            enabled  = true,
            size     = 6,
            passes   = 2,
            vibrancy = 0.1696,
        },

        -- Small neutral shadow for depth; no coloured glow
        shadow = {
            enabled      = true,
            range        = 6,
            render_power = 3,
            color        = "rgba(00000066)",
        },
    },

    animations = {
        enabled = true,
    },

    dwindle = {
        preserve_split = true,
    },

    misc = {
        force_default_wallpaper = 0,
        disable_hyprland_logo   = true,
        -- 0.57 plays a sound for the xdg-system-bell protocol by default (e.g. terminal bells)
        bell_sound              = "none",
        -- A GUI app started from kitty (mpv, imv, zathura…) takes the terminal's
        -- place instead of splitting the screen; the terminal returns when it closes.
        -- Matched against kitty's title: wev must stay visible beside its terminal.
        enable_swallow          = true,
        swallow_regex           = "^(kitty)$",
        swallow_exception_regex = "^(wev).*",
    },

    input = {
        kb_layout          = "us",
        follow_mouse       = 1,
        sensitivity        = 0,
        numlock_by_default = true,

        touchpad = {
            natural_scroll       = false,
            tap_to_click         = true,
            clickfinger_behavior = true,
        },
    },

    -- Get the pointer out of the way: hide it while typing or after 3s idle.
    cursor = {
        inactive_timeout  = 3,
        hide_on_key_press = true,
    },
})

--------------------
---- ANIMATIONS ----
--------------------

hl.curve("myBezier", { type = "bezier", points = { {0.05, 0.9}, {0.1, 1.05} } })

hl.curve("smoothOut", { type = "bezier", points = { {0.36, 0}, {0.66, -0.56} } })
hl.curve("easeOutQuint", { type = "bezier", points = { {0.23, 1}, {0.32, 1} } })
hl.curve("linear", { type = "bezier", points = { {0, 0}, {1, 1} } })

hl.animation({ leaf = "windows",          enabled = true, speed = 7,   bezier = "myBezier" })
hl.animation({ leaf = "windowsIn",        enabled = true, speed = 5,   bezier = "myBezier",     style = "popin 80%" })
hl.animation({ leaf = "windowsOut",       enabled = true, speed = 4,   bezier = "smoothOut",    style = "popin 80%" })
hl.animation({ leaf = "border",           enabled = true, speed = 10,  bezier = "default" })
hl.animation({ leaf = "fade",             enabled = true, speed = 6,   bezier = "default" })
hl.animation({ leaf = "layersIn",         enabled = true, speed = 4,   bezier = "easeOutQuint", style = "fade" })
hl.animation({ leaf = "layersOut",        enabled = true, speed = 2,   bezier = "linear",       style = "fade" })
hl.animation({ leaf = "workspaces",       enabled = true, speed = 6,   bezier = "easeOutQuint", style = "slide" })
hl.animation({ leaf = "specialWorkspace", enabled = true, speed = 5,   bezier = "myBezier",     style = "slidevert" })


