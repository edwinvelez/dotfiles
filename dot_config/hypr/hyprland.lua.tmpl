------------------
---- MONITORS ----
------------------

{{- if .is_desktop }}
hl.monitor({
    output   = "HDMI-A-1",
    mode     = "preferred",
    position = "auto",
    scale    = 1.25,
})
{{- else if .is_laptop }}
hl.monitor({
    output   = "eDP-1",
    mode     = "preferred",
    position = "auto",
    scale    = 1.5,
})
{{- end }}

------------------
---- PATHWAYS ----
------------------

-- Ensure module resolution is directed to the local config space
package.path = package.path .. ";" .. os.getenv("HOME") .. "/.config/hypr/?.lua"

-----------------
---- MODULES ----
-----------------

-- Load system hardware environments
require("configs.env_common")
require("configs.env")

-- Load core lifecycle startups
require("configs.execs")

-----------------------
---- LOOK AND FEEL ----
-----------------------

hl.config({
    xwayland = {
        force_zero_scaling = true,
    },

    general = {
        gaps_in = 5,
        gaps_out = 10,
        border_size = 3,
        col = {
            active_border   = { colors = {"rgba(5294e2ee)", "rgba(3b6ba4ee)"}, angle = 45 },
            inactive_border = "rgba(212121aa)",
        },
        layout = "dwindle",
    },

    decoration = {
        rounding = 10,
        dim_inactive = true,
        dim_strength = 0.1,

        blur = {
            enabled  = true,
            size     = 6,
            passes   = 2,
            vibrancy = 0.1696,
        },

        shadow = {
            enabled      = true,
            range        = 4,
            render_power = 3,
            color        = "rgba(1a1a1aee)",
        },
    },

    animations = {
        enabled = true,
    },

    dwindle = {
        preserve_split = true,
    },

    misc = {
        force_default_wallpaper = 0,
        disable_hyprland_logo   = true,
    },

    input = {
        kb_layout          = "us",
        follow_mouse       = 1,
        sensitivity        = 0,
        numlock_by_default = true,

        touchpad = {
            natural_scroll       = false,
            tap_to_click         = true,
            clickfinger_behavior = true,
        },
    },
})

--------------------
---- ANIMATIONS ----
--------------------

hl.curve("myBezier", { type = "bezier", points = { {0.05, 0.9}, {0.1, 1.05} } })

hl.animation({ leaf = "windows",    enabled = true, speed = 7, bezier = "myBezier" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 6, bezier = "default" })

------------------
---- GESTURES ----
------------------

hl.gesture({
    fingers = 3,
    direction = "horizontal",
    action = "workspace",
})

hl.gesture({
    fingers = 3,
    direction = "down",
    mod = "ALT",
    action = "close",
})

hl.gesture({
    fingers = 3,
    direction = "up",
    mod = "SUPER",
    scale = 1.5,
    action = "fullscreen",
})

-------------------------
---- RULES & BINDS ------
-------------------------

-- Load structural window behaviors
require("configs.windowrules")

-- Load modular keybindings
require("configs.keybinds")
