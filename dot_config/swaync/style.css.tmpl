{{- $t := .theme -}}
/* Generated from .chezmoidata/theme.toml ({{ $t.name }}) */

* {
  font-family: "Inter", "JetBrainsMono Nerd Font";
  font-size: 13px;
}

.control-center .notification-row:focus,
.control-center .notification-row:hover {
  opacity: 1;
  background: transparent;
}

.notification-row {
  outline: none;
  margin: 5px;
  padding: 0;
}

.notification {
  background: alpha(#{{ $t.surface }}, 0.95);
  padding: 10px;
  margin: 0px;
  border-radius: {{ $t.radius }}px;
  border: 1px solid alpha(#{{ $t.text }}, 0.06);
  box-shadow: 0 4px 10px alpha(#000000, 0.35);
}

.notification.critical {
  border: 1px solid #{{ $t.alert }};
}

.notification-content {
  background: transparent;
  padding: 5px;
  border-radius: 8px;
}

/* OSD / progress notifications (volume, brightness) */
.notification-content progressbar {
  margin-top: 8px;
}

.notification-content progressbar trough {
  min-height: 8px;
  border-radius: 999px;
  background: #{{ $t.overlay }};
}

.notification-content progressbar progress {
  min-height: 8px;
  border-radius: 999px;
  background-image: none;
  background-color: #{{ $t.accent }};
}

.close-button {
  background: #{{ $t.overlay }};
  color: #{{ $t.text }};
  text-shadow: none;
  padding: 0;
  border-radius: 100%;
  margin-top: 5px;
  margin-right: 5px;
  box-shadow: none;
  border: none;
  min-width: 24px;
  min-height: 24px;
}

.close-button:hover {
  box-shadow: none;
  background: #{{ $t.alert }};
  transition: all .15s ease-in-out;
  border: none;
}

.notification-default-action {
  margin: 0;
  padding: 0;
  border-radius: 8px;
}

.notification-action {
  border-top: 1px solid #{{ $t.overlay }};
  border-radius: 8px;
  background: transparent;
  color: #{{ $t.accent }};
}

.notification-action:hover {
  background: alpha(#{{ $t.accent }}, 0.15);
}

.summary {
  color: #{{ $t.text }};
  font-weight: bold;
}

.time {
  color: #{{ $t.muted }};
}

.body {
  color: #{{ $t.text }};
  font-weight: normal;
}

.control-center {
  background: alpha(#{{ $t.base }}, 0.72); /* translucent for blur */
  border-radius: 16px;
  border: 1px solid #{{ $t.overlay }};
  box-shadow: 0 8px 24px alpha(#000000, 0.4);
  padding: 10px;
}

.control-center-list {
  background: transparent;
}

.control-center-list-placeholder {
  color: #{{ $t.muted }};
  opacity: 0.5;
}

.control-center-list-placeholder-title {
  color: #{{ $t.text }};
}

.floating-notifications {
  background: transparent;
}

.blank-window {
  background: transparent;
}

.widget-title {
  color: #{{ $t.text }};
  margin: 10px;
  font-size: 16px;
  font-weight: bold;
}

.widget-title > button {
  background: #{{ $t.overlay }};
  color: #{{ $t.text }};
  border-radius: 8px;
  border: none;
}

.widget-title > button:hover {
  background: #{{ $t.alert }};
  color: #{{ $t.base }};
}

/* ---------- Quick settings ---------- */

/* Menubar: "Settings" and "Power" dropdowns */
.widget-menubar {
  margin: 6px 10px 2px;
}

.widget-menubar > .menu-button-bar > .widget-menubar-container button {
  background: #{{ $t.overlay }};
  color: #{{ $t.text }};
  border: none;
  border-radius: 10px;
  padding: 6px 14px;
  margin: 0;
  box-shadow: none;
}

.widget-menubar > .menu-button-bar > .widget-menubar-container button:hover {
  background: alpha(#{{ $t.text }}, 0.12);
}

.widget-menubar > revealer * button {
  background: alpha(#{{ $t.surface }}, 0.95);
  color: #{{ $t.text }};
  border: none;
  border-radius: 8px;
  padding: 8px 12px;
  margin: 3px 0;
  box-shadow: none;
}

.widget-menubar > revealer * button:hover {
  background: #{{ $t.overlay }};
}

/* Toggle / action tiles */
.widget-buttons-grid {
  margin: 4px 7px;
  padding: 0;
}

.widget-buttons-grid flowboxchild > button {
  background: #{{ $t.overlay }};
  color: #{{ $t.text }};
  border: none;
  border-radius: 10px;
  padding: 12px 4px;
  margin: 3px;
  box-shadow: none;
  transition: background 0.15s ease-in-out, color 0.15s ease-in-out;
}

.widget-buttons-grid flowboxchild > button:hover {
  background: alpha(#{{ $t.text }}, 0.12);
}

.widget-buttons-grid flowboxchild > button.toggle:checked,
.widget-buttons-grid flowboxchild > button.active {
  background: alpha(#{{ $t.accent }}, 0.2);
  color: #{{ $t.accent }};
}

/* ---------- Sliders: volume, brightness ---------- */
.widget-volume,
.widget-backlight {
  background: alpha(#{{ $t.surface }}, 0.9);
  border-radius: 10px;
  margin: 4px 10px;
  padding: 6px 12px;
}

.widget-volume > box > label,
.widget-backlight > label,
.widget-volume label,
.widget-backlight label {
  color: #{{ $t.accent }};
  font-family: "JetBrainsMono Nerd Font";
  font-size: 16px;
}

.widget-volume scale trough,
.widget-backlight scale trough {
  min-height: 6px;
  border-radius: 999px;
  background: #{{ $t.overlay }};
}

.widget-volume scale highlight,
.widget-backlight scale highlight {
  border-radius: 999px;
  background: #{{ $t.accent }};
}

.widget-volume scale slider,
.widget-backlight scale slider {
  min-width: 14px;
  min-height: 14px;
  border-radius: 999px;
  border: none;
  box-shadow: none;
  background: #{{ $t.text }};
}

.widget-volume button {
  background: transparent;
  color: #{{ $t.muted }};
  border: none;
  box-shadow: none;
}

.widget-volume button:hover {
  color: #{{ $t.text }};
}

.per-app-volume {
  background: alpha(#{{ $t.base }}, 0.6);
  border-radius: 8px;
  margin-top: 6px;
  padding: 4px;
}

.widget-volume row image {
  -gtk-icon-size: 20px;
}

.widget-mpris {
  background: alpha(#{{ $t.surface }}, 0.9);
  border-radius: {{ $t.radius }}px;
  margin: 10px;
  padding: 10px;
}

.widget-mpris-player {
  padding: 5px;
}

.widget-mpris-title {
  font-weight: bold;
  color: #{{ $t.text }};
}

.widget-mpris-subtitle {
  color: #{{ $t.muted }};
}
