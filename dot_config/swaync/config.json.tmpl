{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "cssPriority": "application",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 10,
  "notification-2way-close": true,
  "notification-drop-shadow": true,
  "label-drop-shadow": true,
  "control-center-width": 380,
  "fit-to-screen": false,
  "control-center-height": -1,
  "notification-window-width": 350,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "All caught up",
  "script-fail-notify": true,

  "widgets": [
    "menubar",
    "buttons-grid",
    "volume",
{{- if .is_laptop }}
    "backlight",
{{- end }}
    "mpris",
    "title",
    "notifications"
  ],

  "widget-config": {
    "menubar": {
      "menu#settings": {
        "label": "󰒓  Settings",
        "position": "left",
        "actions": [
          { "label": "󰤨   Network",   "command": "sh -c 'swaync-client -cp; nm-connection-editor &'" },
          { "label": "󰂯   Bluetooth", "command": "sh -c 'swaync-client -cp; blueman-manager &'" },
          { "label": "󰕾   Audio",     "command": "sh -c 'swaync-client -cp; pavucontrol &'" }
        ]
      },
      "menu#power": {
        "label": "󰐥  Power",
        "position": "right",
        "actions": [
          { "label": "󰌾   Lock",      "command": "sh -c 'swaync-client -cp; loginctl lock-session'" },
          { "label": "󰤄   Suspend",   "command": "sh -c 'swaync-client -cp; systemctl suspend'" },
          { "label": "󰍃   Log out",   "command": "sh -c 'swaync-client -cp; hyprshutdown -t \"Logging out...\"'" },
          { "label": "󰜉   Restart",   "command": "sh -c 'swaync-client -cp; hyprshutdown -t \"Restarting...\" -p \"systemctl reboot\"'" },
          { "label": "󰐥   Shut down", "command": "sh -c 'swaync-client -cp; hyprshutdown -t \"Shutting down...\" -p \"systemctl poweroff\"'" }
        ]
      }
    },

    "buttons-grid": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰤨  Wi-Fi",
          "type": "toggle",
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[ \"$(nmcli radio wifi)\" = enabled ] && echo true || echo false'"
        },
        {
          "label": "󰂯  Bluetooth",
          "type": "toggle",
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && bluetoothctl power on || bluetoothctl power off'",
          "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
        },
        {
          "label": "󰂛  DND",
          "type": "toggle",
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && swaync-client -dn || swaync-client -df'",
          "update-command": "swaync-client -D"
        },
        {
          "label": "󰍬  Mic",
          "type": "toggle",
          "command": "sh -c 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ $([ \"$SWAYNC_TOGGLE_STATE\" = true ] && echo 0 || echo 1)'",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo false || echo true'"
        },
        {
          "label": "󰹑  Capture",
          "command": "sh -c 'swaync-client -cp; sleep 0.4; grim -g \"$(slurp)\" - | swappy -f - &'"
        },
        {
          "label": "󰍛  Monitor",
          "command": "sh -c 'swaync-client -cp; kitty -e btop &'"
        }
      ]
    },

    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "empty-list-label": "Nothing playing",
      "expand-button-label": "󰅀",
      "collapse-button-label": "󰅃"
    },
{{- if .is_laptop }}

    "backlight": {
      "label": "󰃠",
      "device": "intel_backlight",
      "subsystem": "backlight",
      "min": 8
    },
{{- end }}

    "mpris": {
      "autohide": true,
      "show-album-art": "when-available"
    },

    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },

    "notifications": {
      "vexpand": true
    }
  }
}
