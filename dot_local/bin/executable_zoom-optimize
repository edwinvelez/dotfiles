#!/usr/bin/env python3
import configparser
import os
import sys
import tempfile

def main():
    conf_path = os.path.expanduser("~/.config/zoomus.conf")
    config = configparser.RawConfigParser()
    config.optionxform = str

    if os.path.exists(conf_path):
        config.read(conf_path)

    if not config.has_section("General"):
        config.add_section("General")

    optimizations = {
        "enableWaylandShare": "true",
        "xwayland": "true",
        "enableQmlCache": "true",
        "captureHDCamera": "true",
        "autoScale": "true",
        "bForceMaximizeWM": "false",
        "enableCefGpu": "false",
        "enablegpucomputeutilization": "false",
        "CefOsrWindowlessFrameRate": "30",
        "enableAlphaBuffer": "true",
        "enableScreenSaveGuard": "false",
    }

    modified = False
    for key, value in optimizations.items():
        if config.get("General", key, fallback=None) != value:
            config.set("General", key, value)
            modified = True

    if not config.has_section("AS"):
        config.add_section("AS")
        modified = True

    if config.get("AS", "showframewindow", fallback=None) != "true":
        config.set("AS", "showframewindow", "true")
        modified = True

    if modified:
        conf_dir = os.path.dirname(conf_path)
        os.makedirs(conf_dir, exist_ok=True)
        with tempfile.NamedTemporaryFile("w", dir=conf_dir, delete=False) as tf:
            config.write(tf, space_around_delimiters=False)
            temp_name = tf.name
        os.replace(temp_name, conf_path)
        print("[OK] Zoom configuration successfully synchronized with optimal parameters.")
    else:
        print("[INFO] Zoom configuration already matches desired profile.")

if __name__ == "__main__":
    main()
