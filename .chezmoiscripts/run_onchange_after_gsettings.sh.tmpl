#!/usr/bin/env bash
# Applies GNOME/GTK interface settings once per change instead of every login.
# Values persist in dconf; chezmoi re-runs this only when this rendered file changes.
# Values come from .chezmoidata/theme.toml ([ui]) and .chezmoi.toml.tmpl (cursor_size).
set -euo pipefail

apply() {
    local schema=org.gnome.desktop.interface
    gsettings set "$schema" gtk-theme    '{{ .ui.gtk_theme }}'
    gsettings set "$schema" icon-theme   '{{ .ui.icon_theme }}'
    gsettings set "$schema" cursor-theme '{{ .ui.cursor_theme }}'
    gsettings set "$schema" cursor-size  {{ .cursor_size }}
    gsettings set "$schema" font-name    '{{ .ui.font }} {{ .ui.font_size }}'
    gsettings set "$schema" color-scheme 'prefer-dark'
}

if ! command -v gsettings >/dev/null 2>&1; then
    echo "gsettings not found; skipping interface settings" >&2
    exit 0
fi

# Provisioning from a TTY may lack a session bus; dconf needs one to persist writes.
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    export -f apply
    exec dbus-run-session -- bash -c apply
fi

apply
